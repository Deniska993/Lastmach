<Window x:Class="ImagePlatformSorter.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Image Platform Sorter"
        Height="720"
        Width="980"
        MinHeight="680"
        MinWidth="920"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="16"
                Background="#FFF7F7F7"
                BorderBrush="#FFD9D9D9"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <TextBlock FontSize="22"
                           FontWeight="SemiBold"
                           Text="Сортировка изображений по площадкам" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="#FF555555"
                           TextWrapping="Wrap"
                           Text="Приложение копирует изображения по папкам площадок на основе размеров в названии файла или реального размера картинки." />
            </StackPanel>
        </Border>

        <GroupBox Grid.Row="1"
                  Margin="0,16,0,16"
                  Header="Папки и параметры">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Margin="0,0,12,12"
                           VerticalAlignment="Center"
                           Text="Папка с изображениями:" />
                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Margin="0,0,12,12"
                         Text="{Binding InputFolder, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="0"
                        Grid.Column="2"
                        Width="110"
                        Margin="0,0,0,12"
                        Click="BrowseInputFolder_Click"
                        Content="Выбрать" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Margin="0,0,12,12"
                           VerticalAlignment="Center"
                           Text="Выходная папка:" />
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Margin="0,0,12,12"
                         Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="1"
                        Grid.Column="2"
                        Width="110"
                        Margin="0,0,0,12"
                        Click="BrowseOutputFolder_Click"
                        Content="Выбрать" />

                <CheckBox Grid.Row="2"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          IsChecked="{Binding OverwriteExisting}"
                          Content="Перезаписывать файлы, если они уже существуют в папке площадки" />
            </Grid>
        </GroupBox>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Margin="0,0,16,0"
                      Header="Выбор площадок">
                <DockPanel Margin="12">
                    <Button DockPanel.Dock="Top"
                            Width="180"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Left"
                            Click="OpenAdminWindow_Click"
                            Content="Управление площадками" />

                    <DataGrid AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              IsReadOnly="False"
                              ItemsSource="{Binding Platforms}"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Width="90"
                                                    Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Header="Выбрать" />
                            <DataGridTextColumn Width="180"
                                                Binding="{Binding Name}"
                                                Header="Площадка"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Width="*"
                                                Binding="{Binding SizesDisplay}"
                                                Header="Размеры"
                                                IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <GroupBox Grid.Column="1"
                      Header="Лог работы">
                <Grid Margin="12">
                    <TextBox AcceptsReturn="True"
                             HorizontalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             Text="{Binding RunLog}"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </Grid>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="3"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="190"
                    Height="38"
                    Click="RunSorting_Click"
                    Content="Запустить сортировку" />
        </StackPanel>
    </Grid>
</Window>

