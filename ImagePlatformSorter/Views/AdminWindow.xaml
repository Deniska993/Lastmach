<Window x:Class="ImagePlatformSorter.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="РђРґРјРёРЅРєР° РїР»РѕС‰Р°РґРѕРє"
        Height="520"
        Width="860"
        MinHeight="500"
        MinWidth="820"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,12"
                   Foreground="#FF555555"
                   Text="{Binding ConfigPathDisplay}"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      ItemsSource="{Binding Platforms}"
                      SelectedItem="{Binding SelectedPlatform, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="220"
                                        Binding="{Binding Name}"
                                        Header="РџР»РѕС‰Р°РґРєР°"
                                        IsReadOnly="True" />
                    <DataGridTextColumn Width="*"
                                        Binding="{Binding SizesDisplay}"
                                        Header="Р Р°Р·РјРµСЂС‹"
                                        IsReadOnly="True" />
                    <DataGridTextColumn Width="140"
                                        Binding="{Binding MaxFileSizeDisplay}"
                                        Header="РњР°РєСЃ. РІРµСЃ"
                                        IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Column="1"
                        Margin="16,0,0,0">
                <Button Height="34"
                        Margin="0,0,0,10"
                        Click="AddPlatform_Click"
                        Content="Р”РѕР±Р°РІРёС‚СЊ" />
                <Button Height="34"
                        Margin="0,0,0,10"
                        Click="EditPlatform_Click"
                        Content="Р РµРґР°РєС‚РёСЂРѕРІР°С‚СЊ" />
                <Button Height="34"
                        Click="DeletePlatform_Click"
                        Content="РЈРґР°Р»РёС‚СЊ" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="120"
                    Margin="0,0,12,0"
                    Click="Cancel_Click"
                    Content="РћС‚РјРµРЅР°" />
            <Button Width="160"
                    Click="Save_Click"
                    Content="РЎРѕС…СЂР°РЅРёС‚СЊ Рё Р·Р°РєСЂС‹С‚СЊ" />
        </StackPanel>
    </Grid>
</Window>
